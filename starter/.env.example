# Workspace blog key from rankveo → Settings → API keys. Server-side only:
# never rename this to NEXT_PUBLIC_*.
RANKVEO_BLOG_API_KEY=rk_your_blog_key

# Your production origin, used for canonical URLs and the sitemap.
NEXT_PUBLIC_SITE_URL=https://yoursite.com

# Optional. Set this and paste the same value into
# rankveo → Integrations → Next.js to get instant updates on publish.
RANKVEO_REVALIDATE_SECRET=
